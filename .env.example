# Supabase project URL (Project Settings -> API -> Project URL)
# Example: https://your-project-ref.supabase.co
SUPABASE_URL=

# Supabase Service Role Key (kept strictly on the server — NEVER expose to client)
# Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback key if you prefer anon key with custom RLS policies
SUPABASE_ANON_KEY=

# Server port (defaults to 3000)
PORT=3000

# Application URL (optional, injected automatically in hosted environments)
APP_URL="http://localhost:3000"
